# Turso (production). Create one with:
#   turso db create knoknok
#   turso db show knoknok --url
#   turso db tokens create knoknok
# Leave both unset locally and the app uses a SQLite file at DB_PATH instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file, used only when TURSO_DATABASE_URL is unset.
DB_PATH=data/knoknok.db

# Optional: run triage on Claude instead of the built-in rules engine.
ANTHROPIC_API_KEY=

# Origins allowed to call this API from a browser, comma-separated. Only needed
# when the front end is hosted somewhere other than the API — e.g. GitHub Pages:
#   ALLOWED_ORIGINS=https://your-name.github.io
ALLOWED_ORIGINS=

# Where the front end lives, for links in emails (reset links, "open the
# request" links). Set this in production — especially for a GitHub Pages front
# end, which lives under a path the API cannot see.
#   APP_URL=https://your-name.github.io/knoknok
APP_URL=

# Optional: email notifications and password-reset links, via Resend.
# Without a key, notifications are written to the server log instead.
RESEND_API_KEY=
NOTIFY_FROM=knoknok <notifications@your-domain.com>

# Optional: text messages for emergencies only, via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
