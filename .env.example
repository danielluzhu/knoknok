# Turso (production). Create one with:
#   turso db create knoknok
#   turso db show knoknok --url
#   turso db tokens create knoknok
# Leave both unset locally and the app uses a SQLite file at DB_PATH instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file, used only when TURSO_DATABASE_URL is unset.
DB_PATH=data/knoknok.db

# Optional: run triage on Claude instead of the built-in rules engine.
ANTHROPIC_API_KEY=
