# Turso (production). Create one with:
#   turso db create knoknok
#   turso db show knoknok --url
#   turso db tokens create knoknok
# Leave both unset locally and the app uses a SQLite file at DB_PATH instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file, used only when TURSO_DATABASE_URL is unset.
DB_PATH=data/knoknok.db

# Optional: run triage on Claude instead of the built-in rules engine.
ANTHROPIC_API_KEY=

# Optional: hand each request to Qwin once the assistant has the category and
# the four basics. Both must be set; with either missing the assistant keeps
# the whole conversation. QWIN_API_URL is POSTed one JSON turn at a time and
# QWIN_API_KEY goes in the Authorization header as a bearer token. See the
# "Qwin" section of the README for the request and reply shapes.
QWIN_API_URL=
QWIN_API_KEY=
# How long to wait for Qwin before the assistant answers instead (ms).
QWIN_TIMEOUT_MS=25000

# Origins allowed to call this API from a browser, comma-separated. Only needed
# when the front end is hosted somewhere other than the API — e.g. GitHub Pages:
#   ALLOWED_ORIGINS=https://your-name.github.io
ALLOWED_ORIGINS=
